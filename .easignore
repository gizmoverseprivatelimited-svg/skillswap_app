# -------------------------------
# Exclude backend folder
# -------------------------------
server/

# -------------------------------
# Node modules (EAS will install them)
# -------------------------------
node_modules/

# -------------------------------
# Local environment and config files
# -------------------------------
.env
.env.local
.env.*.local
*.keystore
*.jks

# -------------------------------
# Git and version control
# -------------------------------
.git/
.gitignore

# -------------------------------
# Logs, caches, and temp files
# -------------------------------
*.log
*.tmp
*.tsbuildinfo
.expo/
.expo-shared/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# -------------------------------
# IDE / editor configs
# -------------------------------
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# -------------------------------
# Misc / build files not needed in APK
# -------------------------------
*.bak
*.swp
.DS_Store
Thumbs.db
coverage/
tests/
__tests__/